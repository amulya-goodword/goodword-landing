---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, GA_ID, VERIFY } from '../config';

interface Props {
  title: string;
  description: string;
  /** The page key used to tag links to the app, for example "home" or "how_it_works". */
  page: string;
  /** Internal review pages are kept out of search. */
  noindex?: boolean;
  /** Share image under /og/, without the extension. */
  og?: string;
}
const { title, description, page, noindex = false, og = 'default' } = Astro.props;
const ogImage = new URL(`/og/${og}.png`, SITE.url).toString();
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {VERIFY.google && <meta name="google-site-verification" content={VERIFY.google} />}
    {VERIFY.bing && <meta name="msvalidate.01" content={VERIFY.bing} />}
    <link rel="preload" href="/fonts/inter-gw.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f1b2d" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer page={page} />
    <script is:inline define:vars={{ GA_ID }}>
      // 1. Campaign tracking. A visitor who arrived with utm or ref parameters keeps them on every link to the app,
      //    on this page and on the pages they visit next. Without this script the links still carry the site's own tags.
      (function () {
        var KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'ref'];
        var got = {}, has = false, q = new URLSearchParams(location.search);
        KEYS.forEach(function (k) { var v = q.get(k); if (v) { got[k] = v; has = true; } });
        try {
          if (has) sessionStorage.setItem('gw_attr', JSON.stringify(got));
          else { var s = sessionStorage.getItem('gw_attr'); if (s) { got = JSON.parse(s); has = true; } }
        } catch (e) {}
        if (has) {
          var ownUtm = KEYS.slice(0, 5).some(function (k) { return got[k]; });
          document.querySelectorAll('a[data-app-link]').forEach(function (a) {
            var u = new URL(a.href);
            if (ownUtm) KEYS.slice(0, 5).forEach(function (k) { u.searchParams.delete(k); });
            KEYS.forEach(function (k) { if (got[k]) u.searchParams.set(k, got[k]); });
            a.href = u.toString();
          });
        }
        // 2. Analytics, loaded late: on the first interaction or a few seconds after the page has loaded.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', GA_ID);
        var loaded = false;
        function load() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script'); s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) { addEventListener(e, load, { once: true, passive: true }); });
        addEventListener('load', function () { setTimeout(load, 4000); });
        // 3. Clicks on the signup and sample buttons, by page and by section.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-cta]');
          if (!a) return;
          var c = a.getAttribute('data-cta');
          if (c === 'signup' || c === 'sample') {
            gtag('event', c + '_click', { page: a.getAttribute('data-page'), section: a.getAttribute('data-section'), transport_type: 'beacon' });
            load();
          }
        });
      })();
    </script>
  </body>
</html>
