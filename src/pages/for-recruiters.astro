---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import AppLink from '../components/AppLink.astro';
import Arrow from '../components/Arrow.astro';
import StepMock from '../components/home/StepMock.astro';
import Verified from '../components/home/Verified.astro';

const title = 'For recruiters: how to read a GoodWord report';
const description = 'A candidate sent you a GoodWord report. What it contains, what is checked and what is not, why it asks for your work email and where its limits are.';
---
<Base title={title} description={description} page="for_recruiters" og="for-recruiters">
  <PageHead trail={[{ href: '/for-recruiters/', label: 'For recruiters' }]} title="A candidate sent you a GoodWord report." lede="What you are looking at, what is checked and where its limits are." />

  <section class="section" style="padding-top: 0">
    <div class="wrap rows">
      <div class="row">
        <div class="row-copy">
          <h2>What it is</h2>
          <p>References the candidate collected from people they have worked with: managers, peers, people who reported to them and clients. Each one answered a short questionnaire in their own words.</p>
          <p>Words only. No ratings and no scores. The candidate cannot edit what anyone wrote.</p>
          <p><AppLink to="sample" page="for_recruiters" section="body" class="btn btn-dark">Read a full sample report <Arrow /></AppLink></p>
        </div>
        <div class="row-visual"><StepMock kind="shot-report" /></div>
      </div>
    </div>
  </section>

  <Verified />

  <section class="section surface">
    <div class="wrap">
      <div class="facts-grid">
        <div class="fact-card"><h3>Why it asks for your work email</h3><p>You confirm a work email with a one-time code to open a shared report. The candidate then sees your name and company. They never see your email address.</p></div>
        <div class="fact-card"><h3>The PDF and the live report</h3><p>A PDF carries a QR code and a link to the live report. The live report is how you check that a PDF is real. A report is valid for 12 months.</p></div>
        <div class="fact-card"><h3>You see roles</h3><p>Each referee appears by role, such as Direct Manager. A name shows only where that referee chose to be named.</p></div>
        <div class="fact-card"><h3>References are views</h3><p>A reference is one person’s account of working with another. Read it as that, alongside your own interview.</p></div>
      </div>
      <figure class="fr-quote">
        <blockquote>It's easier for us to identify the real potential candidates, quicker.</blockquote>
        <figcaption>A hiring manager in our pilot</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow stack" style="--stack: var(--s-4)">
      <h2>Ask for it in your job post</h2>
      <p class="lede">If a report saved you time, tell candidates you welcome them. Copy this line into your next job post.</p>
      <p class="answer" id="jd-line">We welcome applications with a GoodWord report: verified references from people you have worked with. goodword.tech</p>
      <p><button type="button" class="btn btn-dark" id="jd-copy" hidden>Copy the line</button> <span class="meta" id="jd-done" role="status"></span></p>
    </div>
  </section>
  <script is:inline>
    // The line can always be selected by hand. The button appears only where the browser can copy for you.
    (function () {
      var b = document.getElementById('jd-copy'), t = document.getElementById('jd-line'), d = document.getElementById('jd-done');
      if (!b || !navigator.clipboard) return;
      b.hidden = false;
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(t.textContent.trim()).then(function () { d.textContent = 'Copied.'; }, function () { d.textContent = 'Could not copy. Select the line and copy it by hand.'; });
      });
    })();
  </script>
  <CtaBand page="for_recruiters" title="Looking for a job yourself?" line="Collect your own references and send them with every application." />
</Base>

<style is:global>
  .row-visual:has(.dk-shot) { justify-items: center; }
  .fr-quote { margin-top: var(--s-7); display: grid; gap: var(--s-2); max-width: 40rem; padding-left: var(--s-5); border-left: 3px solid var(--gold); }
  .fr-quote blockquote { font-family: var(--serif); font-size: var(--step-3); line-height: 1.25; }
  .fr-quote figcaption { font-size: var(--step--1); color: var(--ink-3); }
</style>
