---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import StepMock from '../components/home/StepMock.astro';
const title = 'Resume Pro Max: your resume and your references in one file';
const description = 'Resume Pro Max joins the resume you wrote to your GoodWord report, so the people who vouch for you arrive in the same file. Your resume is never stored.';
---
<Base title={title} description={description} page="resume_pro_max" og="resume-pro-max">
  <PageHead trail={[{ href: '/resume-pro-max/', label: 'Resume Pro Max' }]} title="Your resume and your references, in one file." lede="The half you write and the half only other people can, in one PDF you send whenever a person will open it." />

  <section class="section" style="padding-top: 0">
    <div class="wrap rows">
      <div class="row">
        <div class="row-copy">
          <h2>Your resume + your report = one file</h2>
          <p>Your resume goes in exactly as you wrote it. Not reformatted and not edited.</p>
          <p>Your report is rebuilt fresh each time you make the file, so it always carries your latest references. Every report page shows your report ID and a link to the live report.</p>
        </div>
        <div class="row-visual"><StepMock kind="shot-rpm-parts" /></div>
      </div>
      <div class="row">
        <div class="row-copy">
          <h2>Upload, then download</h2>
          <p>Choose your resume as a PDF. You get one file back: your pages first, then your report.</p>
          <p>Your resume is never stored. It is held in memory for that one request and then discarded.</p>
          <p>You need an unlocked report first. That means three references.</p>
        </div>
        <div class="row-visual"><StepMock kind="shot-rpm-make" /></div>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap-narrow">
      <p class="answer"><strong>For people, not portals.</strong> Job portals that read resumes automatically work best with a plain resume. Send Resume Pro Max when a person will open the file.</p>
    </div>
  </section>
  <CtaBand page="resume_pro_max" />
</Base>

<style is:global>
  .row-visual:has(.dk-shot) { justify-items: center; }
</style>
