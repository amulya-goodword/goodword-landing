---
import Base from '../layouts/Base.astro';
import Tick from '../components/Tick.astro';
import QuoteCard from '../components/report/QuoteCard.astro';
import Piece from '../components/report/ReportPieces.astro';
import { sample } from '../data/sample';
const r = sample.referees;
const claims = [
  { n: 1, text: 'Turned around merchant onboarding. Completion rose from about half to over 70 percent in a quarter.' },
  { n: 2, text: 'Trusted partner to engineering on scope and dates.' },
  { n: 3, text: 'Coached associate product managers into owning their own launches.' },
];
const notes = [
  { n: 1, role: r[0].role, who: r[0].label, words: 'He spent a week sitting in on support calls, came back with one page that showed where merchants were actually getting stuck, and had engineering, risk and sales agree on a plan in a single meeting.' },
  { n: 2, role: r[1].role, who: 'Shown by role', words: 'Engineers on my team trusted him because he never promised something on our behalf without asking first.' },
  { n: 3, role: r[2].role, who: 'Shown by role', words: 'He reviewed my first three documents line by line and never rewrote them for me.' },
];
---
<Base title="Signature concepts · GoodWord" description="Two working concepts for the signature moment on the GoodWord home page." page="concepts" noindex>
  <section class="section cx-intro">
    <div class="wrap-narrow stack" style="--stack: var(--s-4)">
      <p class="eyebrow">Signature moment</p>
      <h1>Two concepts. Scroll through each.</h1>
      <p class="lede">Both are built from the style page and both are real text. Each plays as you scroll and runs backwards when you scroll up. With motion turned off, or in a browser that cannot do scroll animation, each shows its finished state and reads just as well.</p>
    </div>
  </section>

  <!-- ============ Concept 1 ============ -->
  <div class="wrap-narrow cx-label stack" style="--stack: var(--s-3)">
    <p class="eyebrow">Concept 1</p>
    <h2>Three voices, one report</h2>
    <p>Each referee's words arrive, the count moves from one to three and the report unlocks. It teaches the one rule every candidate needs: three references open your report.</p>
  </div>

  <section class="c1" aria-label="Concept 1: three voices, one report">
    <div class="c1-stage">
      <div class="wrap c1-grid">
        <div class="c1-left">
          <h2 class="c1-kicker">Three people who know your work. One report.</h2>
          <ol class="c1-voices">
            <li class="c1-voice v1 anim"><QuoteCard referee={r[0]} variant="short" /></li>
            <li class="c1-voice v2 anim"><QuoteCard referee={r[1]} variant="short" /></li>
            <li class="c1-voice v3 anim"><QuoteCard referee={r[2]} variant="short" /></li>
          </ol>
        </div>
        <div class="c1-right">
          <div class="rp rp-pad c1-report">
            <div class="c1-status">
              <p class="rp-label">Your report</p>
              <div class="c1-counts">
                <p class="c1-count c0 anim" aria-hidden="true">Invites sent. Waiting for the first response.</p>
                <p class="c1-count ca anim" aria-hidden="true">1 of 3 responses in.</p>
                <p class="c1-count cb anim" aria-hidden="true">2 of 3 responses in. One more unlocks it.</p>
                <p class="c1-count cc anim">3 of 3 responses in. Your report is unlocked.</p>
              </div>
              <ol class="c1-meter" aria-hidden="true"><li class="b1 anim"></li><li class="b2 anim"></li><li class="b3 anim"></li></ol>
            </div>
            <div class="c1-body">
              <div class="c1-locked anim" aria-hidden="true">
                <span class="c1-lock"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="12" height="8" rx="2" /><path d="M7 9V6.5a3 3 0 016 0V9" /></svg></span>
                <p>Unlocks at 3 references</p>
                <div class="c1-skeleton"><i style="width:88%"></i><i style="width:72%"></i><i style="width:80%"></i><i style="width:56%"></i></div>
              </div>
              <div class="c1-open anim stack" style="--stack: var(--s-3)">
                <p class="tally"><span class="ticks"><Tick /><Tick /><Tick /></span><span>{sample.tally}</span></p>
                <p class="rp-label">Validated strengths</p>
                <ul class="points">
                  <li><Tick small /><span>{sample.strengths[0]}</span></li>
                  <li><Tick small /><span>{sample.strengths[1]}</span></li>
                </ul>
                <p><span class="chip chip-navy">Response Integrity: {sample.integrity.level}</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Concept 2 ============ -->
  <div class="wrap-narrow cx-label stack" style="--stack: var(--s-3)">
    <p class="eyebrow">Concept 2</p>
    <h2>Says who?</h2>
    <p>A resume makes three claims. One by one, someone who was there backs each claim in their own words. It is the brand idea in a single picture, and it carries your headline for the resume comparison.</p>
  </div>

  <section class="c2" aria-label="Concept 2: says who">
    <div class="c2-stage">
      <div class="wrap">
        <h2 class="c2-h">The part of your application you cannot write yourself.</h2>
        <div class="c2-grid">
          <div class="rp rp-pad c2-resume">
            <p class="c2-name">Aarav Mehta</p>
            <p class="meta">Senior Product Manager · Bengaluru</p>
            <p class="rp-label rp-label-quiet c2-exp">Experience, as he wrote it</p>
            <ul class="c2-claims">
              {claims.map((c) => (
                <li class:list={['c2-claim', `k${c.n}`, 'anim']}>
                  <span class="c2-n" aria-hidden="true">{c.n}</span>
                  <span class="c2-t">{c.text}</span>
                </li>
              ))}
            </ul>
          </div>
          <ol class="c2-notes" aria-label="What the people he worked with said">
            {notes.map((n) => (
              <li class="c2-slot">
                <span class:list={['c2-tag', `t${n.n}`, 'anim']} aria-hidden="true">Says who?</span>
                <div class:list={['c2-note', `n${n.n}`, 'anim']}>
                  <span class="c2-n c2-n-gold" aria-hidden="true">{n.n}</span>
                  <figure class="stack" style="--stack: var(--s-2)">
                    <blockquote>{n.words}</blockquote>
                    <figcaption class="cluster" style="--cluster: var(--s-2)"><span class="chip chip-gold"><Tick small />{n.role} · Verified</span><span class="meta">{n.who}</span></figcaption>
                  </figure>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <p class="c2-close anim">Your resume says it. <span class="gold-text">They back it up.</span></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow stack" style="--stack: var(--s-4)">
      <p class="eyebrow">My recommendation</p>
      <h2>Says who? as the signature. Three voices in How it works.</h2>
      <p>Says who? is the one people will describe to a friend. It shows the gap in every resume and closes it in the same breath, and it needs no explanation of the product first. Three voices is the clearer teacher of the three-reference rule, so it earns its place lower down, where the page explains how a report comes together.</p>
      <p class="meta">The resume lines in concept 2 are written by me to sit beside Aarav's real sample references. Nothing else on this page is invented.</p>
    </div>
  </section>
</Base>

<style is:global>
  .cx-intro { padding-bottom: var(--s-6); }
  .cx-label { padding-block: var(--s-7) var(--s-5); border-top: 1px solid var(--line); }
  .cx-label h2 { font-size: var(--step-3); }

  /* ---------- Concept 1: the finished state, which is what shows without scroll animation ---------- */
  .c1 { padding-block: var(--s-6) var(--s-8); }
  .c1-grid { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 62rem) { .c1-grid { grid-template-columns: 1fr 1fr; gap: var(--s-8); } }
  .c1-kicker { font-size: var(--step-3); margin-bottom: var(--s-5); max-width: 18ch; }
  .c1-voices { display: grid; gap: var(--s-3); }
  .c1-report { display: grid; gap: var(--s-4); box-shadow: var(--sh-3); }
  .c1-status { display: grid; gap: var(--s-2); }
  .c1-count { font-weight: 750; line-height: 1.3; }
  .c1-count.c0, .c1-count.ca, .c1-count.cb { display: none; }
  .c1-meter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.375rem; }
  .c1-meter li { height: 0.5rem; border-radius: var(--r-pill); background: var(--line); position: relative; }
  .c1-meter li::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--gold); opacity: 1; }
  .c1-body { display: grid; }
  .c1-locked { display: none; }
  .c1-locked, .c1-open { grid-area: 1 / 1; }
  .c1-lock { width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--canvas); border: 1px solid var(--line); display: grid; place-items: center; color: var(--ink-2); }
  .c1-lock svg { width: 1.25rem; height: 1.25rem; }
  .c1-skeleton { display: grid; gap: 0.5rem; width: 100%; margin-top: var(--s-2); }
  .c1-skeleton i { display: block; height: 0.625rem; border-radius: var(--r-pill); background: var(--line); }

  /* ---------- Concept 2: the finished state ---------- */
  .c2 { padding-block: var(--s-6) var(--s-8); }
  .c2-h { font-size: var(--step-4); max-width: 20ch; margin-bottom: var(--s-5); }
  .c2-grid { display: grid; gap: var(--s-5); align-items: start; }
  @media (min-width: 62rem) { .c2-grid { grid-template-columns: 1fr 1fr; gap: var(--s-7); align-items: center; } }
  .c2-resume { box-shadow: var(--sh-3); }
  .c2-name { font-size: var(--step-2); font-weight: 850; letter-spacing: -0.03em; line-height: 1.1; }
  .c2-exp { display: block; margin-top: var(--s-4); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .c2-claims { display: grid; gap: var(--s-4); margin-top: var(--s-4); }
  .c2-claim { position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; line-height: 1.5; isolation: isolate; }
  .c2-claim::before { content: ''; position: absolute; inset: -0.5rem -0.625rem; border-radius: var(--r-sm); background: var(--gold-tint); z-index: -1; opacity: 1; }
  .c2-n { width: 1.625rem; height: 1.625rem; border-radius: 50%; background: var(--ink); color: var(--on-navy); display: grid; place-items: center; font-size: 0.875rem; font-weight: 800; flex: none; }
  .c2-n-gold { background: var(--gold); color: var(--ink); }
  .c2-slot { position: relative; }
  .c2-tag { display: none; position: absolute; left: var(--s-4); top: 50%; margin-top: -1.125rem; z-index: 2; background: var(--ink); color: var(--on-navy); font-weight: 800; font-size: var(--step-1); line-height: 1; padding: 0.625rem 1rem; border-radius: var(--r-pill); box-shadow: var(--sh-2); white-space: nowrap; }
  .c2-notes { display: grid; gap: var(--s-3); }
  .c2-note { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--s-4); box-shadow: var(--sh-2); }
  .c2-note blockquote { font-weight: 600; line-height: 1.45; letter-spacing: -0.005em; }
  .c2-close { margin-top: var(--s-6); font-size: var(--step-3); font-weight: 850; letter-spacing: -0.03em; line-height: 1.1; text-wrap: balance; }

  /* ---------- The scroll-driven versions. Transform and opacity only. ---------- */
  @media (prefers-reduced-motion: no-preference) and (min-width: 62rem) and (min-height: 600px), (prefers-reduced-motion: no-preference) and (max-width: 61.99rem) and (min-height: 740px) {
    @supports (animation-timeline: view()) {
      .c1, .c2 { padding-block: 0; view-timeline-axis: block; }
      .c1 { height: 340vh; view-timeline-name: --c1; }
      .c2 { height: 380vh; view-timeline-name: --c2; }
      .c1-stage, .c2-stage { position: sticky; top: 4rem; height: calc(100svh - 4rem); display: grid; align-items: center; overflow: clip; }
      .c1 .anim { animation-timeline: --c1; }
      .c2 .anim { animation-timeline: --c2; }
      .c1 .anim, .c2 .anim { animation-range: contain 0% contain 100%; animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; }

      /* Concept 1 */
      .c1-voices { gap: 0; padding-top: 2.25rem; }
      .c1-voice { grid-area: 1 / 1; transform-origin: 50% 0; }
      .v1 { animation-name: c1-v1; z-index: 1; }
      .v2 { animation-name: c1-v2; z-index: 2; }
      .v3 { animation-name: c1-v3; z-index: 3; }
      @keyframes c1-v1 { 0%, 2% { opacity: 0; transform: translateY(28px); } 10%, 30% { opacity: 1; transform: none; } 38%, 58% { opacity: 0.6; transform: translateY(-17px) scale(0.955); } 66%, 100% { opacity: 0.32; transform: translateY(-32px) scale(0.91); } }
      @keyframes c1-v2 { 0%, 30% { opacity: 0; transform: translateY(28px); } 38%, 58% { opacity: 1; transform: none; } 66%, 100% { opacity: 0.6; transform: translateY(-17px) scale(0.955); } }
      @keyframes c1-v3 { 0%, 58% { opacity: 0; transform: translateY(28px); } 66%, 100% { opacity: 1; transform: none; } }

      .c1-counts { display: grid; }
      .c1-count { grid-area: 1 / 1; }
      .c1-count.c0, .c1-count.ca, .c1-count.cb { display: block; }
      .c0 { animation-name: c1-c0; } .ca { animation-name: c1-ca; } .cb { animation-name: c1-cb; } .cc { animation-name: c1-cc; }
      @keyframes c1-c0 { 0%, 6% { opacity: 1; } 9%, 100% { opacity: 0; } }
      @keyframes c1-ca { 0%, 7% { opacity: 0; } 10%, 34% { opacity: 1; } 37%, 100% { opacity: 0; } }
      @keyframes c1-cb { 0%, 35% { opacity: 0; } 38%, 62% { opacity: 1; } 65%, 100% { opacity: 0; } }
      @keyframes c1-cc { 0%, 63% { opacity: 0; } 66%, 100% { opacity: 1; } }

      .c1-meter li::after { transform-origin: 0 50%; }
      .c1-meter .b1.anim, .c1-meter .b2.anim, .c1-meter .b3.anim { animation: none; }
      .c1-meter .b1::after { animation: c1-b1 linear both; animation-timeline: --c1; animation-range: contain 0% contain 100%; }
      .c1-meter .b2::after { animation: c1-b2 linear both; animation-timeline: --c1; animation-range: contain 0% contain 100%; }
      .c1-meter .b3::after { animation: c1-b3 linear both; animation-timeline: --c1; animation-range: contain 0% contain 100%; }
      @keyframes c1-b1 { 0%, 4% { transform: scaleX(0); } 10%, 100% { transform: none; } }
      @keyframes c1-b2 { 0%, 32% { transform: scaleX(0); } 38%, 100% { transform: none; } }
      @keyframes c1-b3 { 0%, 60% { transform: scaleX(0); } 66%, 100% { transform: none; } }

      .c1-locked { display: grid; justify-items: center; align-content: center; gap: var(--s-2); text-align: center; font-weight: 700; color: var(--ink-2); animation-name: c1-locked; }
      .c1-open { animation-name: c1-open; }
      @keyframes c1-locked { 0%, 66% { opacity: 1; transform: none; } 73%, 100% { opacity: 0; transform: scale(0.97); } }
      @keyframes c1-open { 0%, 68% { opacity: 0; transform: translateY(14px); } 78%, 100% { opacity: 1; transform: none; } }

      /* Concept 2 */
      .c2-h { font-size: var(--step-3); margin-bottom: var(--s-5); }
      .c2-close { margin-top: var(--s-4); animation-name: c2-close; }
      .c2-claim::before { animation: c2-hl linear both; animation-timeline: --c2; }
      .k1::before { animation-range: contain 8% contain 14%; }
      .k2::before { animation-range: contain 36% contain 42%; }
      .k3::before { animation-range: contain 64% contain 70%; }
      .c2-claim.anim { animation: none; }
      @keyframes c2-hl { from { opacity: 0; } to { opacity: 1; } }
      .c2-tag { display: block; transform-origin: 20% 100%; }
      .t1 { animation-name: c2-t1; } .t2 { animation-name: c2-t2; } .t3 { animation-name: c2-t3; }
      @keyframes c2-t1 { 0%, 11% { opacity: 0; transform: scale(0.6) rotate(-10deg); } 15%, 20% { opacity: 1; transform: rotate(-3deg); } 23%, 100% { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
      @keyframes c2-t2 { 0%, 39% { opacity: 0; transform: scale(0.6) rotate(-10deg); } 43%, 48% { opacity: 1; transform: rotate(-3deg); } 51%, 100% { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
      @keyframes c2-t3 { 0%, 67% { opacity: 0; transform: scale(0.6) rotate(-10deg); } 71%, 76% { opacity: 1; transform: rotate(-3deg); } 79%, 100% { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
      .n1 { animation-name: c2-n1; } .n2 { animation-name: c2-n2; } .n3 { animation-name: c2-n3; }
      @keyframes c2-n1 { 0%, 23% { opacity: 0; transform: translateY(16px); } 31%, 100% { opacity: 1; transform: none; } }
      @keyframes c2-n2 { 0%, 51% { opacity: 0; transform: translateY(16px); } 59%, 100% { opacity: 1; transform: none; } }
      @keyframes c2-n3 { 0%, 79% { opacity: 0; transform: translateY(16px); } 87%, 100% { opacity: 1; transform: none; } }
      @keyframes c2-close { 0%, 90% { opacity: 0; transform: translateY(12px); } 97%, 100% { opacity: 1; transform: none; } }
    }
  }
  /* On a phone there is room for one note at a time, so each gives way to the next. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 61.99rem) and (min-height: 740px) {
    @supports (animation-timeline: view()) {
      .c1-kicker { font-size: var(--step-1); margin-bottom: var(--s-2); max-width: none; }
      .c1-grid { gap: var(--s-3); }
      .c1-voices { padding-top: 1.75rem; }
      .c1-voice .rp-pad, .c1-report.rp-pad { padding: var(--s-3) var(--s-4); }
      .c1-voice .quote { gap: var(--s-2); }
      .c1-voice .quote-mark { width: 1.5rem; height: 1.125rem; }
      .c1-report { gap: var(--s-3); }
      .c1-open .points li:nth-child(2) { display: none; }
      .c2-h { font-size: var(--step-2); margin-bottom: var(--s-4); }
      .c2-grid { gap: var(--s-4); }
      .c2-claims { gap: var(--s-3); margin-top: var(--s-3); }
      .c2-claim { font-size: 0.9375rem; }
      .c2-exp { margin-top: var(--s-3); }
      .c2-notes { gap: 0; }
      .c2-slot { grid-area: 1 / 1; }
      .c2-tag { top: var(--s-5); margin-top: 0; }
      .c2-close { font-size: var(--step-2); }
      @keyframes c2-n1 { 0%, 23% { opacity: 0; transform: translateY(20px); } 30%, 37% { opacity: 1; transform: none; } 41%, 100% { opacity: 0; transform: translateY(-14px); } }
      @keyframes c2-n2 { 0%, 51% { opacity: 0; transform: translateY(20px); } 58%, 65% { opacity: 1; transform: none; } 69%, 100% { opacity: 0; transform: translateY(-14px); } }
      @keyframes c2-n3 { 0%, 79% { opacity: 0; transform: translateY(20px); } 87%, 100% { opacity: 1; transform: none; } }
    }
  }
</style>
