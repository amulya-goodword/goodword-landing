---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const title = 'Guides: references, resumes and job applications in India';
const description = 'Practical guides for job seekers in India: how to ask for a reference, which letter is which and what recruiters really check.';
---
<Base title={title} description={description} page="guides" og="guides">
  <PageHead trail={[{ href: '/guides/', label: 'Guides' }]} eyebrow="Guides" title="Straight answers for your job search." lede="Each guide answers one question, in its first paragraph. Useful whether or not you ever use GoodWord." />
  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="facts-grid three">
        {guides.map((g) => (
          <article class="card card-raised guide-card">
            <h2><a href={`/guides/${g.id}/`}>{g.data.title}</a></h2>
            <p>{g.data.description}</p>
            <span class="link" aria-hidden="true">Read the guide</span>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CtaBand page="guides" />
</Base>

<style is:global>
  .guide-card { position: relative; display: grid; gap: var(--s-3); align-content: start; transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease); }
  .guide-card:hover { transform: translateY(-3px); box-shadow: var(--sh-3); }
  .guide-card h2 { font-size: var(--step-2); letter-spacing: -0.02em; line-height: 1.2; }
  .guide-card h2 a { color: inherit; text-decoration: none; }
  /* The title is the link. Its hit area is stretched over the whole card. */
  .guide-card h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .guide-card h2 a:focus-visible { outline: none; }
  .guide-card h2 a:focus-visible::after { outline: 3px solid var(--ink); outline-offset: 3px; }
  .guide-card p { color: var(--ink-2); font-size: var(--step--1); line-height: 1.55; }
  .guide-card .link { justify-self: start; font-size: var(--step--1); }
</style>
