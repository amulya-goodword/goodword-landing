---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Tick from '../components/Tick.astro';
import { sample } from '../data/sample';
import { SITE } from '../config';
const r = sample.referees[2];

const title = 'For referees: what happens when someone asks you for a GoodWord';
const description = 'You were invited to give a reference on GoodWord. What you will be asked, how long it takes, who will read it and how to withdraw.';
// Every answer below is also on the page, so the questions search engines read match what people see.
const qs = [
  { q: 'Is this real?', a: 'Yes. GoodWord collects references for job seekers. The person named in your email chose you and gave us your email address.' },
  { q: 'What will I be asked?', a: 'Where this person excels, where they could grow and whether you would want them on your team again. You answer in your own words.' },
  { q: 'How long does it take?', a: 'About 5 minutes. The link in your email is private to you and works for 30 days.' },
  { q: 'Who will read it?', a: 'The person who invited you and the recruiters they share their report with. Recruiters see your role, such as Direct Manager. They do not see your name unless you choose to be named.' },
  { q: 'Will they know what I wrote?', a: 'Yes. The person who invited you can read every word and knows who wrote what. They cannot edit any of it.' },
  { q: 'Can I change my mind?', a: 'Yes. After you submit, the page shows a link to withdraw your reference. The same link is in your confirmation email. It takes one click and a confirm.' },
];
const asked = ['Where do they excel?', 'Where could they grow?', 'Would you want them on your team again?'];
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: qs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title={title} description={description} page="for_referees" og="for-referees">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <PageHead trail={[{ href: '/for-referees/', label: 'For referees' }]} title="Someone asked you to vouch for them." lede="Here is what you will be asked, how long it takes and who will read it." />

  <section class="section" style="padding-top: 0" aria-labelledby="rf-ask">
    <div class="wrap">
      <h2 id="rf-ask" class="sr-only">What you will be asked</h2>
      <ol class="rf-qs">
        {asked.map((q, i) => (
          <li class="reveal"><span class="rf-n" aria-hidden="true">{i + 1}</span><span class="rf-q">{q}</span></li>
        ))}
      </ol>
      <p class="rf-time">About 5 minutes, in your own words. The link in your email is private to you and works for 30 days.</p>
    </div>
  </section>

  <section class="section surface" aria-labelledby="rf-words">
    <div class="wrap rf-split">
      <div class="stack" style="--stack: var(--s-4)">
        <h2 id="rf-words">How your words appear</h2>
        <p class="lede">As you wrote them, under your role. Your name shows only if you choose to be named.</p>
        <p class="lede">Please be honest about where they could grow. Every reference includes it, and it is what makes the rest believable. GoodWord writes a short summary of all the references with AI. Your own words are never changed.</p>
      </div>
      <figure class="rf-quote">
        <blockquote>{r.excel}</blockquote>
        <figcaption><span class="chip chip-gold"><Tick small />{r.role} · Verified</span><span class="meta">From a sample report</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="rf-who">
    <div class="wrap rf-split">
      <h2 id="rf-who">Who reads it</h2>
      <ul class="rf-list">
        <li><Tick small /><span><strong>The person who invited you</strong> reads every word and knows it was you. They cannot edit any of it.</span></li>
        <li><Tick small /><span><strong>The recruiters they share it with</strong> see your role, such as Direct Manager, and your name only if you chose to be named.</span></li>
        <li><Tick small /><span><strong>It is not public.</strong> A report opens only for people the candidate sends it to, after they confirm a work email.</span></li>
      </ul>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="facts-grid three">
        <div class="fact-card"><h3>Is this real?</h3><p>{qs[0].a}</p></div>
        <div class="fact-card"><h3>Can I change my mind?</h3><p>{qs[5].a}</p></div>
        <div class="fact-card"><h3>Something not right?</h3><p>If you did not expect the invite, or have a concern about how your words are used, write to <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p></div>
      </div>
    </div>
  </section>
  <CtaBand page="for_referees" title="Collect your own GoodWord." />
</Base>

<style is:global>
  .rf-qs { display: grid; gap: var(--s-4); }
  @media (min-width: 62rem) { .rf-qs { grid-template-columns: repeat(3, 1fr); gap: var(--s-5); } }
  .rf-qs li { display: grid; gap: var(--s-4); align-content: space-between; min-height: 13rem; padding: var(--s-6); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .rf-n { font-family: var(--serif); font-size: var(--step-3); color: var(--gold-ink); line-height: 1; }
  .rf-q { font-family: var(--serif); font-size: var(--step-4); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance; }
  .rf-time { margin-top: var(--s-5); font-size: var(--step-1); color: var(--ink-2); }
  .rf-split { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 62rem) { .rf-split { grid-template-columns: 0.85fr 1.15fr; gap: var(--s-8); } }
  .rf-quote { display: grid; gap: var(--s-4); padding-left: var(--s-5); border-left: 3px solid var(--gold); }
  .rf-quote blockquote { font-family: var(--serif); font-size: var(--step-2); line-height: 1.4; }
  .rf-quote figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .rf-list { display: grid; }
  .rf-list li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); padding-block: var(--s-4); border-top: 1px solid var(--line); font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .rf-list li:last-child { border-bottom: 1px solid var(--line); }
  .rf-list .tick { margin-top: 0.3rem; }
  .rf-list strong { color: var(--ink); }
</style>
