---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ReportSheet from '../components/home/ReportSheet.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Story from '../components/home/Story.astro';
import WhoFor from '../components/home/WhoFor.astro';
import Share from '../components/home/Share.astro';
import Trust from '../components/home/Trust.astro';
import { SITE, APP } from '../config';

const title = 'GoodWord: verified references for your job applications';
const description =
  'Collect verified references from managers, peers and clients, and share them as one report with every job application.';

// The questions on the page and the FAQ data search engines read come from this one list.
const faqs = [
  { q: 'How many references do I need?', a: 'Three references unlock your report. You can include up to 5. A report is valid for 12 months.' },
  { q: 'Will my current employer find out?', a: 'Only if you invite someone who works there. You choose every referee and nobody else is contacted. Former managers, old colleagues and clients all count.' },
  { q: 'What does a referee have to do?', a: 'They open a private link from their email and answer a short questionnaire in their own words. It takes about 5 minutes. The link works for 30 days.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.company,
      url: `${SITE.url}/`,
      logo: `${SITE.url}/icon-512.png`,
      email: SITE.email,
      slogan: SITE.signature,
      address: { '@type': 'PostalAddress', streetAddress: 'Tower 4, NESCO, Goregaon East', addressLocality: 'Mumbai', addressCountry: 'IN' },
    },
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: `${SITE.url}/`, inLanguage: 'en-IN', publisher: { '@id': `${SITE.url}/#organization` } },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: `${APP.base}${APP.paths.register}`,
      description,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title={title} description={description} page="home" og="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Hero />
  <Story />
  <HowItWorks />
  <ReportSheet />
  <WhoFor />
  <Share />
  <Trust faqs={faqs} />
</Base>
