---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ReportSheet from '../components/home/ReportSheet.astro';
import SaysWho from '../components/home/SaysWho.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Share from '../components/home/Share.astro';
import Trust from '../components/home/Trust.astro';
import { SITE, APP } from '../config';

const title = 'GoodWord: verified references for your job applications';
const description =
  'Collect verified references from managers, peers and clients, and share them as one report with every job application. Free for the first 1,000 members.';

// The questions on the page and the FAQ data search engines read come from this one list.
const faqs = [
  { q: 'What is GoodWord?', a: 'GoodWord lets you collect verified references from people you have worked with and share them as one report, as a link and as a PDF, with every job application.' },
  { q: 'Is it free?', a: 'Yes, for founding members. That is the first 1,000 people to join. No card is needed.' },
  { q: 'How many references do I need?', a: 'Three references unlock your report. You can include up to 5. A report is valid for 12 months.' },
  { q: 'What does a referee have to do?', a: 'They open a private link from their email and answer a short questionnaire in their own words. It takes about 5 minutes. The link works for 30 days.' },
  { q: 'Can I edit what my referees wrote?', a: 'No. You read every word and you know who wrote what, and you cannot change any of it. That is why a recruiter can rely on it.' },
  { q: 'Will recruiters see my referees’ names?', a: 'Recruiters see each referee by role, for example Direct Manager. A name appears only where that referee chose to be named.' },
  { q: 'Is this a background check?', a: 'No. GoodWord checks that each reference came from the email address you gave and looks for signs of misuse. It does not verify identity documents or employment records.' },
  { q: 'How does a recruiter know a report is real?', a: 'The PDF carries a QR code and a link to the live report. The live report is the proof. To open it, a recruiter confirms a work email with a one-time code.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.company,
      url: `${SITE.url}/`,
      email: SITE.email,
      slogan: SITE.signature,
      address: { '@type': 'PostalAddress', streetAddress: 'Tower 4, NESCO, Goregaon East', addressLocality: 'Mumbai', addressCountry: 'IN' },
    },
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: `${SITE.url}/`, inLanguage: 'en-IN', publisher: { '@id': `${SITE.url}/#organization` } },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: `${APP.base}${APP.paths.register}`,
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', description: 'Free for the first 1,000 members' },
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title={title} description={description} page="home" og="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Hero />
  <ReportSheet />
  <SaysWho />
  <HowItWorks />
  <Share />
  <Trust faqs={faqs} />
</Base>
