---
// What you can do with a report. Each claim sits beside the piece of the product that backs it.
import Piece from '../report/ReportPieces.astro';
---
<section class="section share" aria-labelledby="share-h">
  <div class="wrap">
    <div class="share-head">
      <p class="eyebrow">With your report</p>
      <h2 id="share-h">Send it wherever you apply.</h2>
    </div>

    <div class="bento">
      <article class="tile tile-link reveal">
        <div class="tile-copy">
          <h3>See who opened it</h3>
          <p>A recruiter confirms a work email before your report opens.</p>
        </div>
        <Piece piece="viewers" />
      </article>

      <article class="tile tile-pdf reveal">
        <div class="tile-copy">
          <h3>A PDF with a QR code</h3>
          <p>Scan it to open the live report.</p>
        </div>
        <div class="tile-center"><Piece piece="pdf" /></div>
      </article>

      <article class="tile tile-li reveal">
        <div class="tile-copy">
          <h3>A card for LinkedIn</h3>
          <p>Shows a report exists. Opens none of it.</p>
        </div>
        <Piece piece="linkedin" />
      </article>

      <article class="tile tile-rpm reveal">
        <div class="tile-copy">
          <h3>Resume Pro Max</h3>
          <p>Your resume and your report, in one file.</p>
          <p><a class="link" href="/resume-pro-max/">About Resume Pro Max</a></p>
        </div>
        <div class="rpm" aria-hidden="true">
          <span class="rpm-page rpm-resume"><i style="width:60%"></i><i style="width:90%"></i><i style="width:78%"></i><i style="width:84%"></i><i style="width:52%"></i></span>
          <span class="rpm-page rpm-report"><b></b><i style="width:88%"></i><i style="width:70%"></i><i style="width:80%"></i></span>
        </div>
      </article>

      <article class="tile tile-send reveal">
        <div class="tile-copy">
          <h3>Send it</h3>
          <p>We write the message. You send it yourself.</p>
        </div>
        <ul class="cluster send-kinds">
          <li class="chip chip-gold">Writing to a recruiter</li>
          <li class="chip chip-gold">I have already applied</li>
          <li class="chip chip-gold">Asking for a referral</li>
          <li class="chip chip-gold">Following up</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .share-head { display: grid; gap: var(--s-3); max-width: 44rem; }
  .bento { margin-top: var(--s-7); display: grid; gap: var(--s-4); }
  /* Each tile is its words, then its picture. The picture sits in the middle of whatever room is left. */
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem, 0.9rem + 1.6vw, 2rem); display: grid; grid-template-rows: auto 1fr; gap: var(--s-5); overflow: hidden; }
  .tile > :last-child { align-self: center; }
  .tile-copy { display: grid; gap: var(--s-2); align-content: start; }
  .tile h3 { font-size: var(--step-2); }
  .tile-copy p { color: var(--ink-2); max-width: 44ch; }
  .tile .rp { box-shadow: none; background: var(--canvas); }
  .tile-center { display: grid; justify-items: center; }
  .tile-center .pdf { width: 100%; max-width: 14rem; }
  .tile-li .li-card { max-width: none; }
  .send-kinds .chip { font-size: var(--step-0); padding: 0.5rem 0.875rem; }
  /* With room, the list of viewers takes the app's layout, dates on the right, so the card is wide and short. */
  @media (min-width: 40rem) {
    .tile-link .viewers li { grid-template-columns: auto 1fr auto; }
    .tile-link .avatar { grid-row: auto; align-self: center; }
    .tile-link .viewer-side { grid-column: auto; text-align: right; }
  }
  @media (min-width: 62rem) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .tile-link { grid-column: span 4; grid-template-columns: 0.56fr 1.44fr; grid-template-rows: auto; align-items: center; gap: var(--s-6); }
    .tile-pdf { grid-column: span 2; }
    .tile-li { grid-column: span 3; }
    .tile-rpm { grid-column: span 3; }
    .tile-rpm .rpm { transform: scale(1.35); }
    .tile-send { grid-column: span 6; grid-template-columns: minmax(14rem, 1fr) auto; grid-template-rows: auto; align-items: center; gap: var(--s-6); }
    .tile-send .send-kinds { justify-content: flex-end; }
  }
  @media (min-width: 40rem) and (max-width: 61.99rem) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .tile-link { grid-column: span 2; }
  }

</style>
