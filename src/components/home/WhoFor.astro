---
// Who it is for, as four small pictures and two or three words each.
// The sample report is a senior manager's. This is here so nobody reads that and thinks it is not for them.
const who = [
  { k: 'move', t: 'Changing jobs' },
  { k: 'first', t: 'Your first job' },
  { k: 'back', t: 'Back after a break' },
  { k: 'off', t: 'Laid off' },
];
---
<section class="who" aria-labelledby="who-h">
  <div class="wrap who-in">
    <h2 id="who-h">Wherever you are in your career.</h2>
    <ul class="who-row">
      {who.map((w) => (
        <li class="reveal">
          <span class="who-pic" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              {w.k === 'move' && <><path d="M6 19h18v15H6z" /><path d="M11 19v-4h8v4" /><path class="who-g" d="M30 26h12M37 21l5 5-5 5" /></>}
              {w.k === 'first' && <><path d="M4 19l20-9 20 9-20 9z" /><path d="M12 23v9c7 5 17 5 24 0v-9" /><path class="who-g" d="M44 19v11" /></>}
              {w.k === 'back' && <><path d="M9 12v24M17 12v24" /><path class="who-g" d="M27 12l14 12-14 12z" /></>}
              {w.k === 'off' && <><path d="M8 20h32v18H8z" /><path d="M5 13h38v7H5z" /><path class="who-g" d="M20 28h8" /></>}
            </svg>
          </span>
          <span class="who-t">{w.t}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  .who { padding-block: clamp(2.5rem, 2rem + 2.4vw, 4rem); background: var(--surface); border-block: 1px solid var(--line); }
  .who-in { display: grid; gap: var(--s-6); align-items: center; }
  .who h2 { font-size: var(--step-3); max-width: 14ch; }
  .who-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-5) var(--s-4); }
  .who-row li { display: grid; justify-items: center; gap: var(--s-3); text-align: center; }
  .who-pic { display: grid; place-items: center; width: 5.5rem; height: 5.5rem; border-radius: 50%; background: var(--canvas); border: 1px solid var(--line); color: var(--ink); }
  .who-pic svg { width: 2.75rem; height: 2.75rem; }
  .who-g { stroke: var(--gold); }
  .who-t { font-weight: 750; letter-spacing: -0.01em; line-height: 1.25; }
  @media (min-width: 40rem) { .who-row { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 62rem) { .who-in { grid-template-columns: 0.8fr 1.6fr; gap: var(--s-8); } }
  @media (prefers-reduced-motion: no-preference) {
    .who-pic { transition: transform 0.5s cubic-bezier(0.2, 1.4, 0.4, 1); transition-delay: inherit; }
    .js .who-row .reveal:not(.in) .who-pic { transform: scale(0.6); }
  }
</style>
