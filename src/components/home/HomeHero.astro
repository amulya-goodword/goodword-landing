---
// The opening: the promise, two buttons and one report. The report sits closed and opens once it is in view,
// to show a line from a resume beside what someone who was there says about it.
import AppLink from '../AppLink.astro';
import Arrow from '../Arrow.astro';
import Tick from '../Tick.astro';
import Wordmark from '../Wordmark.astro';
import { sample } from '../../data/sample';
const ref = sample.referees[0];
---
<section class="hx" aria-labelledby="hx-h">
  <div class="wrap hx-copy">
    <h1 id="hx-h" class="hx-h">Your good work deserves a <span class="hx-hl">GoodWord</span>.</h1>
    <p class="hx-sub">References from people who have worked with you, in one report you send with every job application.</p>
    <div class="hx-cta">
      <AppLink to="register" page="home" section="hero" class="btn btn-primary btn-lg">Start my GoodWord <Arrow /></AppLink>
      <AppLink to="sample" page="home" section="hero" class="btn btn-ghost btn-lg">See a sample report</AppLink>
    </div>
    <p class="hx-free">Free to use.</p>
  </div>

  <div class="wrap">
    <div class="hx-book">
      <span class="hx-sheet hx-s2" aria-hidden="true"></span>
      <span class="hx-sheet hx-s1" aria-hidden="true"></span>
      <figure class="hx-page">
        <p class="hx-claim"><span class="hx-l">His resume says</span><span>Turned around merchant onboarding in one quarter.</span></p>
        <div class="hx-answer">
          <span class="hx-l hx-l-gold">His manager says</span>
          <blockquote>{ref.excelShort}</blockquote>
          <figcaption><span class="chip chip-gold"><Tick small />{ref.role} · Verified</span><span class="meta">{ref.label}</span></figcaption>
        </div>
      </figure>
      <div class="hx-cover" aria-hidden="true">
        <Wordmark decorative style="color:#fff" />
        <div class="hx-cover-who"><span class="hx-cover-l">Credibility Report</span><span class="hx-cover-n">{sample.candidate.name}</span></div>
        <span class="hx-cover-f"><i></i>3 verified references</span>
      </div>
    </div>
    <p class="hx-note">A sample. Aarav and his referees are fictional.</p>
  </div>
</section>

<script is:inline>
  // The report opens when most of it is on screen. Without this script it opens as the page loads.
  (function () {
    var book = document.querySelector('.hx-book');
    if (!book || !('IntersectionObserver' in window)) return;
    book.classList.add('wait');
    var seen = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return;
      book.classList.remove('wait');
      seen.disconnect();
    }, { threshold: 0.6 });
    seen.observe(book);
  })();
</script>

<style is:global>
  .hx { padding-block: clamp(3rem, 1.5rem + 6vw, 6.5rem) var(--section); overflow-x: clip; }
  .hx-copy { display: grid; justify-items: center; text-align: center; }
  .hx-h { font-size: var(--step-6); max-width: 13ch; line-height: 1.02; letter-spacing: -0.025em; }
  .hx-hl { position: relative; display: inline-block; }
  .hx-hl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.07em; border-radius: var(--r-pill); background: var(--gold); transform-origin: 0 50%; }
  .hx-sub { margin-top: var(--s-5); max-width: 34rem; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }
  .hx-cta { margin-top: var(--s-6); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); }
  @media (max-width: 30rem) { .hx-cta { width: 100%; } .hx-cta .btn { width: 100%; } }
  .hx-free { margin-top: var(--s-3); font-size: var(--step--1); color: var(--ink-3); }

  /* The report, open. A resume line on one side, what the manager says on the other. */
  .hx-book { position: relative; margin: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) auto 0; width: min(100%, 50rem); }
  .hx-sheet { position: absolute; inset: 0; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .hx-s1 { transform: translate(0.5rem, 0.6rem) rotate(0.8deg); }
  .hx-s2 { transform: translate(1rem, 1.2rem) rotate(1.6deg); opacity: 0.6; }
  .hx-page { position: relative; display: grid; gap: var(--s-5); padding: clamp(1.25rem, 0.75rem + 2.4vw, 2.5rem); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(15, 27, 45, 0.28); }
  @media (min-width: 48rem) { .hx-page { grid-template-columns: 0.8fr 1.2fr; gap: var(--s-7); align-items: start; } }
  .hx-l { display: block; margin-bottom: var(--s-2); font-size: var(--step--1); font-weight: 650; color: var(--ink-3); }
  .hx-l-gold { color: var(--gold-ink); }
  .hx-claim { padding: var(--s-4); border-radius: var(--r-md); border: 1.5px dashed var(--line-strong); background: var(--canvas); color: var(--ink-2); font-weight: 600; line-height: 1.45; }
  .hx-answer blockquote { font-family: var(--serif); font-size: var(--step-3); font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
  .hx-answer figcaption { margin-top: var(--s-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .hx-note { margin-top: var(--s-6); text-align: center; font-size: var(--step--1); color: var(--ink-3); }
  .hx-cover { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .hx-copy > * { animation: hx-up 0.8s var(--ease) both; }
    .hx-copy > :nth-child(2) { animation-delay: 0.12s; }
    .hx-copy > :nth-child(3) { animation-delay: 0.22s; }
    .hx-copy > :nth-child(4) { animation-delay: 0.3s; }
    @keyframes hx-up { from { opacity: 0; transform: translateY(14px); } }
    .hx-hl::after { animation: hx-draw 0.7s var(--ease) 0.6s both; }
    @keyframes hx-draw { from { transform: scaleX(0); } }

    /* The cover: closed until the report is in view, then it swings open on its left edge, once. */
    .hx-book { perspective: 1600px; }
    .hx-cover { position: absolute; inset: 0; z-index: 3; display: grid; align-content: space-between; justify-items: start; padding: clamp(1.25rem, 0.75rem + 2.4vw, 2.5rem); border-radius: var(--r-lg); border-left: 6px solid var(--gold); background: var(--ink); color: var(--on-navy); box-shadow: 0 30px 60px -30px rgba(15, 27, 45, 0.45); transform-origin: 0 50%; backface-visibility: hidden; pointer-events: none; animation: hx-open 1.1s cubic-bezier(0.5, 0, 0.2, 1) 0.35s both; }
    .hx-book.wait .hx-cover { animation-play-state: paused; }
    @keyframes hx-open { 0% { transform: none; opacity: 1; } 78% { opacity: 1; } 100% { transform: rotateY(-112deg); opacity: 0; } }
    .hx-cover .wordmark { font-size: 1.375rem; }
    .hx-cover-who { display: grid; gap: 0.25rem; }
    .hx-cover-l { font-size: var(--step--1); font-weight: 650; color: var(--gold); }
    .hx-cover-n { font-family: var(--serif); font-size: var(--step-5); font-weight: 500; letter-spacing: -0.02em; line-height: 1.02; }
    .hx-cover-f { display: grid; gap: var(--s-2); font-size: var(--step--1); font-weight: 600; color: var(--on-navy-2); }
    .hx-cover-f i { display: block; width: 2.5rem; height: 3px; border-radius: var(--r-pill); background: var(--gold); }
  }
</style>
