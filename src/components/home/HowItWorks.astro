---
// Four steps as a deck of cards. Each card holds a piece of the product, and as you scroll the next one
// slides up over the last. A small rail at the foot of the screen shows which step you are on.
import AppLink from '../AppLink.astro';
import StepMock from './StepMock.astro';
import Arrow from '../Arrow.astro';
const steps = [
  { k: 'invite', tone: 'canvas', rail: 'Invite', t: 'Invite up to 5 people', d: 'Managers, peers, people who reported to you, clients. You choose who. Nobody else is contacted.' },
  { k: 'answer', tone: 'navy', rail: 'Answer', t: 'They answer in 5 minutes', d: 'A private link in their email. A short questionnaire. Their own words.' },
  { k: 'unlock', tone: 'gold', rail: 'Unlock', t: 'Three responses unlock it', d: 'You read every word. You cannot edit any of it.' },
  { k: 'send', tone: 'navy', rail: 'Send', t: 'Send it with every application', d: 'A private link, a PDF or joined to your resume.' },
];
---
<section class="how" id="how-it-works" aria-labelledby="how-h">
  <div class="wrap">
    <div class="how-head">
      <p class="eyebrow">How it works</p>
      <h2 id="how-h">Three people who know your work. One report.</h2>
    </div>

    <div class="deck">
      <ol class="deck-cards">
        {steps.map((s, i) => (
          <li class:list={['deck-card', `is-${s.tone}`]} style={`--i:${i}`}>
            <div class="deck-copy">
              <span class="deck-n" aria-hidden="true">{i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              {s.k === 'send' && (
                <div class="deck-cta">
                  <AppLink to="register" page="home" section="how" class="btn btn-primary btn-lg">Start my GoodWord <Arrow /></AppLink>
                  <span>Free to sign up.</span>
                </div>
              )}
            </div>
            <div class="deck-visual">
              <StepMock kind={s.k} />
            </div>
          </li>
        ))}
      </ol>
      <div class="deck-rail" aria-hidden="true">
        <div class="deck-rail-in">
          <i class="deck-rail-on"></i>
          {steps.map((s) => <span>{s.rail}</span>)}
        </div>
      </div>
    </div>

    <div class="how-more">
      <AppLink to="register" page="home" section="how" class="btn btn-primary btn-lg how-more-btn">Start my GoodWord <Arrow /></AppLink>
      <span class="how-more-free">Free to sign up.</span>
      <a class="link" href="/how-it-works/">How it works, step by step</a>
    </div>
  </div>
</section>

<style is:global>
  .how { padding-block: var(--section); background: var(--surface); border-block: 1px solid var(--line); }
  .how-head { display: grid; gap: var(--s-3); max-width: 44rem; }
  /* The ask, at the moment the four steps have been read. On a laptop it sits on the fourth card. On a phone it follows the deck. */
  .how-more { margin-top: var(--s-6); display: grid; gap: var(--s-3); justify-items: start; }
  .how-more-free { font-size: var(--step--1); color: var(--ink-3); }
  .deck-cta { display: none; }
  @media (max-width: 30rem) { .how-more-btn { width: 100%; } }
  @media (min-width: 62rem) {
    .deck-cta { display: grid; gap: var(--s-2); justify-items: start; margin-top: var(--s-3); }
    .deck-cta span { font-size: var(--step--1); color: var(--on-navy-2); }
    .how-more-btn, .how-more-free { display: none; }
  }

  /* The plain layout: four cards, one after another. This is what shows without motion or on a short screen. */
  .deck { margin-top: var(--s-7); }
  .deck-cards { display: grid; gap: var(--s-5); }
  .deck-card { display: grid; gap: var(--s-5); align-content: start; padding: clamp(1.25rem, 0.5rem + 3.4vw, 3.5rem); border-radius: clamp(1.25rem, 1rem + 1vw, 1.75rem); overflow: clip; }
  .deck-card.is-canvas { background: var(--canvas); box-shadow: inset 0 0 0 1px var(--line); }
  .deck-card.is-navy { background: var(--ink); color: var(--on-navy); }
  .deck-card.is-gold { background: var(--gold-wash); box-shadow: inset 0 0 0 1px var(--gold-line); }
  @media (min-width: 62rem) { .deck-card { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: var(--s-8); align-items: center; align-content: center; } }
  .deck-copy { display: grid; gap: var(--s-3); justify-items: start; }
  .deck-n { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--ink); color: var(--on-navy); font-weight: 850; line-height: 1; }
  .is-navy .deck-n { background: var(--gold); color: var(--ink); }
  .deck-copy h3 { font-size: var(--step-4); font-weight: 850; letter-spacing: -0.035em; line-height: 1.06; max-width: 14ch; }
  .deck-copy p { font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); max-width: 30ch; }
  .is-navy .deck-copy p { color: var(--on-navy-2); }
  .deck-visual { display: grid; color: var(--ink); }
  .deck-rail { display: none; }

  /* The pieces of the product inside the cards */
  .dk { display: grid; gap: var(--s-3); align-content: start; width: 100%; max-width: 30rem; justify-self: center; box-shadow: var(--sh-3); }
  .dk-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .dk-av { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--ink); color: var(--on-navy); font-size: 0.875rem; font-weight: 800; letter-spacing: 0.02em; }
  .dk-who { display: grid; min-width: 0; line-height: 1.3; }
  .dk-who b { font-weight: 750; }
  .dk-people { display: grid; }
  .dk-people li { display: flex; align-items: center; gap: var(--s-3); padding-block: 0.625rem; border-top: 1px solid var(--line); }
  .dk-people .dk-who { flex: 1; }
  .dk-people .chip { flex: none; }
  .dk-empty .dk-av { background: none; color: var(--ink-3); border: 1.5px dashed var(--line-strong); font-size: 1.125rem; font-weight: 500; }
  .dk-q { font-weight: 750; line-height: 1.35; }
  .dk-a { position: relative; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); border: 1.5px solid var(--ink); line-height: 1.55; }
  .dk-a i { display: inline-block; width: 2px; height: 1.1em; margin-left: 2px; background: var(--gold); vertical-align: -0.2em; }
  .dk-later { padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--canvas); color: var(--ink-2); font-weight: 650; }
  .dk-status { font-weight: 750; line-height: 1.3; }
  .dk-meter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.375rem; }
  .dk-meter li { height: 0.5rem; border-radius: var(--r-pill); background: var(--bar); overflow: hidden; position: relative; }
  .dk-meter li::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--gold); transform-origin: 0 50%; }
  .dk-mail { display: flex; align-items: center; gap: var(--s-3); padding-bottom: var(--s-3); border-bottom: 1px solid var(--line); }
  .dk-text { line-height: 1.55; }
  .dk-files { display: grid; gap: var(--s-2); }
  .dk-files li { display: flex; align-items: center; gap: var(--s-3); padding: 0.625rem var(--s-3); border-radius: var(--r-md); border: 1px solid var(--line); }
  .dk-files .is-gw { background: var(--gold-wash); border-color: var(--gold-line); }
  .dk-files .tick { width: 2.25rem; height: 2.25rem; }
  .dk-files .tick svg { width: 1rem; height: 1rem; }
  .dk-file { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.25rem; border-radius: var(--r-sm); background: var(--canvas); border: 1px solid var(--line); font-size: 0.875rem; font-weight: 800; letter-spacing: 0; color: var(--ink-2); }
  @media (max-width: 26rem) { .dk-people .chip { display: none; } }

  /* The deck. Each card sticks a little lower than the one before, so the next one slides up and covers it.
     This part needs no script and no animation support, only a screen tall enough to hold a card. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 62rem) and (min-height: 600px), (prefers-reduced-motion: no-preference) and (max-width: 61.99rem) and (min-height: 620px) {
    .deck { --top: 5.5rem; --step: 0.75rem; --h: clamp(24rem, 100svh - 12.5rem, 36rem); --g: 26svh; --d: calc(var(--h) + var(--g) - var(--step)); }
    .deck-cards { gap: var(--g); }
    /* An empty last row, so the fourth card rests for a moment before the deck moves on. */
    .deck-cards::after { content: ''; }
    .deck-card { position: sticky; top: calc(var(--top) + var(--i) * var(--step)); z-index: calc(var(--i) + 1); height: var(--h); transform-origin: 50% 0; }
    .deck-card:not(:first-child) { box-shadow: 0 -1.25rem 2.5rem -1.5rem rgba(15, 27, 45, 0.4); }
    .deck-card.is-canvas:not(:first-child) { box-shadow: inset 0 0 0 1px var(--line), 0 -1.25rem 2.5rem -1.5rem rgba(15, 27, 45, 0.4); }
    .deck-card.is-gold:not(:first-child) { box-shadow: inset 0 0 0 1px var(--gold-line), 0 -1.25rem 2.5rem -1.5rem rgba(15, 27, 45, 0.4); }

    /* Where the browser can tie motion to the scroll position: a covered card steps back a little,
       the three bars fill as the third card arrives and the rail follows along. Transform and opacity only. */
    @supports (animation-timeline: view()) {
      .deck { view-timeline-name: --deck; view-timeline-axis: block; view-timeline-inset: var(--top) 0px; }
      .deck-card:not(:last-child) { animation: deck-under linear both; animation-timeline: --deck; animation-range: contain calc((var(--i) + 1) * var(--d) - var(--h) + var(--step)) contain calc((var(--i) + 1) * var(--d)); }
      @keyframes deck-under { to { transform: scale(0.94); } }
      .dk-meter li::after { animation: deck-fill linear both; animation-timeline: --deck; animation-range: contain calc(2 * var(--d) - var(--h) * (0.62 - var(--b) * 0.16)) contain calc(2 * var(--d) - var(--h) * (0.46 - var(--b) * 0.16)); }
      @keyframes deck-fill { from { transform: scaleX(0); } }

      .deck-rail { display: block; position: sticky; bottom: 1rem; z-index: 10; width: min(100%, 23rem); margin: var(--s-5) auto 0; pointer-events: none; animation: deck-rail-in linear both; animation-timeline: --deck; animation-range: entry 78% entry 100%; }
      @keyframes deck-rail-in { from { opacity: 0; transform: translateY(0.75rem); } }
      .deck-rail-in { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); padding: 0.25rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--sh-2); }
      .deck-rail-in span { position: relative; padding: 0.4375rem 0; text-align: center; font-size: 0.875rem; font-weight: 750; line-height: 1.3; }
      .deck-rail-on { position: absolute; top: 0.25rem; bottom: 0.25rem; left: 0.25rem; width: calc((100% - 0.5rem) / 4); border-radius: var(--r-pill); background: var(--gold); animation: deck-rail-move linear both; animation-timeline: --deck; animation-range: contain calc(var(--d) * 0.45) contain calc(var(--d) * 2.65); }
      /* Three moves, each as the next card passes the middle of the screen. */
      @keyframes deck-rail-move { 0% { transform: none; } 9.09%, 45.45% { transform: translateX(100%); } 54.55%, 90.91% { transform: translateX(200%); } 100% { transform: translateX(300%); } }
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 61.99rem) and (min-height: 620px) {
    .deck { --top: 4.75rem; --step: 0.5rem; --h: clamp(26rem, 100svh - 10.5rem, 38rem); --g: 20svh; }
    /* On a phone the piece of the product is a sheet that runs off the foot of the card, whatever the height of the screen. */
    .deck-card { gap: var(--s-4); padding-bottom: 0; grid-template-rows: auto minmax(0, 1fr); }
    .deck-visual { min-height: 0; }
    .dk { border-bottom: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .dk-more, .dk-text, .dk .points li + li { display: none; }
    .deck-copy { gap: var(--s-2); }
    .deck-copy h3 { font-size: var(--step-3); max-width: none; }
    .deck-copy p { font-size: var(--step-0); max-width: none; }
    .deck-n { width: 1.875rem; height: 1.875rem; font-size: 0.9375rem; }
  }
</style>
