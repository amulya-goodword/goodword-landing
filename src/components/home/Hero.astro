---
// The promise, beside the product at work: a line from a resume, then what someone who was there says about it.
// The three sample referees take turns.
import AppLink from '../AppLink.astro';
import Arrow from '../Arrow.astro';
import Tick from '../Tick.astro';
import { sample } from '../../data/sample';
const r = sample.referees;
// One resume line for each referee, written to sit beside their own words.
const claims = [
  'Turned around merchant onboarding in one quarter.',
  'Trusted partner to engineering on scope and dates.',
  'Coached associate product managers to own their launches.',
];
const says = ['His manager says', 'A peer says', 'Someone on his team says'];
---
<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow enter" style="--at: 0ms">Verified references for your job applications</p>
      <h1 id="hero-h" class="rise">
        <span class="rise-line" style="--d: 0"><span>Your good work</span></span>{' '}
        <span class="rise-line" style="--d: 1"><span>deserves a</span></span>{' '}
        <span class="rise-line" style="--d: 2"><span><span class="hl">GoodWord</span>.</span></span>
      </h1>
      <p class="lede enter" style="--at: 300ms">Let the people who have worked with you help you land your next job.<span class="lede-more"> Their verified references, in one report you send with every application.</span></p>
      <div class="cluster hero-cta enter" style="--at: 400ms">
        <AppLink to="register" page="home" section="hero" class="btn btn-primary btn-lg">Start my GoodWord <Arrow /></AppLink>
        <AppLink to="sample" page="home" section="hero" class="btn btn-ghost btn-lg">See a sample report</AppLink>
      </div>
      <p class="hero-free enter" style="--at: 480ms">Free to sign up. Each referee needs about 5 minutes.</p>
    </div>

    <div class="hv">
      <div class="hv-deck">
        <span class="hv-ghost hv-g2" aria-hidden="true"></span>
        <span class="hv-ghost hv-g1" aria-hidden="true"></span>
        <ol class="hv-cards" aria-label="Three lines from Aarav’s resume, each with what someone he worked with says">
          {r.map((ref, k) => (
            <li class="hv-card" style={`--k:${k}`}>
              <figure class="rp rp-pad quote hv-quote">
                <p class="hv-claim"><span class="rp-label rp-label-quiet">His resume says</span><span class="hv-claim-t">{claims[k]}</span></p>
                <p class="hv-says hv-ans">
                  <svg class="quote-mark" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true"><path d="M0 24V13.5C0 5.6 4.4 1 12.4 0l1.2 3.4C9.4 4.4 7.4 7 7.2 10.4H13V24H0zm18.4 0V13.5C18.4 5.6 22.8 1 30.8 0L32 3.4c-4.2 1-6.2 3.6-6.4 7h5.8V24h-13z" /></svg>
                  <span class="rp-label">{says[k]}</span>
                </p>
                {k === 0 ? (
                  /* The first quote arrives a word at a time. A screen reader gets it as one plain sentence. */
                  <blockquote class="quote-words big hv-ans"><span class="sr-only">{ref.excelShort}</span><span aria-hidden="true">{ref.excelShort.split(' ').map((w, i) => (<><span class="hv-w" style={`--i:${i}`}>{w}</span>{' '}</>))}</span></blockquote>
                ) : (
                  <blockquote class="quote-words big hv-ans">{ref.excelShort}</blockquote>
                )}
                <figcaption class="cluster hv-ans" style="--cluster: var(--s-2)">
                  <span class="chip chip-gold"><Tick small />{ref.role} · Verified</span>
                  <span class="meta">{ref.named ? ref.label : 'Shown by role'}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ol>
      </div>
      <p class="tally hv-tally"><span class="ticks"><Tick /><Tick /><Tick /></span><span>{sample.tally}</span></p>
      <div class="hv-foot enter" style="--at: 1050ms">
        <p class="meta hv-note">A sample. Aarav and his referees are fictional.</p>
        <label class="hv-pause">
          <input type="checkbox" class="sr-only hv-pause-input" />
          <span class="hv-pause-ui" aria-hidden="true"></span>
          <span class="sr-only">Pause the rotating quotes</span>
        </label>
      </div>
    </div>
  </div>

  <div class="wrap">
    <ul class="hero-facts enter" style="--at: 900ms">
      <li><strong>60% more replies</strong><span>when a reference letter went with a job application. Field study, 2020.</span></li>
      <li><strong>7.4 seconds</strong><span>is the first look a recruiter gives a resume. Eye-tracking study, 2018.</span></li>
      <li><strong>74%</strong><span>of job seekers in India have used AI on their resume. Survey, 2024.</span></li>
    </ul>
    <p class="hero-src enter" style="--at: 1000ms"><a class="link" href="/guides/best-way-to-get-a-job/#why-a-good-word-beats-a-good-resume">Where these numbers come from</a></p>
  </div>
</section>

<style is:global>
  .hero { padding-block: clamp(2rem, 1rem + 4.5vw, 5rem) var(--s-8); overflow: clip; }
  .hero-grid { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 62rem) { .hero-grid { grid-template-columns: 1.08fr 0.92fr; gap: var(--s-8); } }
  .hero-copy > * + * { margin-top: var(--s-4); }
  .hero-copy h1 { margin-top: var(--s-3); }
  .rise-line { display: block; overflow: hidden; padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .rise-line > span { display: block; }
  /* The name in the headline is underlined in gold, drawn once the line has risen. */
  .hl { position: relative; display: inline-block; }
  .hl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.085em; border-radius: var(--r-pill); background: var(--gold); transform-origin: 0 50%; }
  .hero-copy .lede { max-width: 34rem; }
  .hero-cta { margin-top: var(--s-5); }
  .hero-copy .hero-free { margin-top: var(--s-3); font-size: var(--step--1); color: var(--ink-3); }
  @media (max-width: 30rem) { .hero-cta .btn { width: 100%; } }

  .hv { display: grid; gap: var(--s-4); max-width: 30rem; width: 100%; margin-inline: auto; }
  .hv-deck { position: relative; padding: 0 1.25rem 1.5rem 0; }
  .hv-ghost { position: absolute; inset: 0 1.25rem 1.5rem 0; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .hv-g1 { transform: translate(0.625rem, 0.75rem) rotate(1.4deg); opacity: 0.8; }
  .hv-g2 { transform: translate(1.25rem, 1.5rem) rotate(2.8deg); opacity: 0.5; }
  .hv-cards { position: relative; display: grid; }
  .hv-card { grid-area: 1 / 1; opacity: 0; display: grid; }
  .hv-card:first-child { opacity: 1; }
  .hv-quote { box-shadow: var(--sh-3); min-height: 19rem; align-content: start; }
  .hv-quote figcaption { align-self: end; margin-top: auto; }
  .hv-quote .quote-words.big { font-size: var(--step-2); }
  /* The line from the resume: a clipping, set apart from the answer below it */
  .hv-claim { display: grid; gap: 0.25rem; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--canvas); border: 1.5px dashed var(--line-strong); }
  .hv-claim-t { font-weight: 650; line-height: 1.4; color: var(--ink-2); }
  .hv-says { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-2); }
  .hv-says .quote-mark { width: 1.375rem; height: 1.03rem; }
  @media (max-width: 30rem) { .hv-quote .quote-words.big { font-size: var(--step-1); } }
  .hv-tally { box-shadow: var(--sh-1); }
  .hv-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  /* Anything that moves by itself for more than a few seconds needs a way to stop it, by keyboard and touch as well as mouse. */
  .hv-pause { display: none; cursor: pointer; flex: none; }
  .hv-pause-ui { position: relative; display: block; width: 2rem; height: 2rem; border-radius: 50%; border: 1.5px solid var(--line-strong); background: var(--surface); }
  .hv-pause-ui::before, .hv-pause-ui::after { content: ''; position: absolute; top: 50%; width: 3px; height: 0.625rem; margin-top: -0.3125rem; background: var(--ink); border-radius: 1px; }
  .hv-pause-ui::before { left: calc(50% - 5px); }
  .hv-pause-ui::after { left: calc(50% + 2px); }
  .hv-pause-input:checked + .hv-pause-ui::before { left: calc(50% - 3px); width: 0; height: 0; margin-top: -0.375rem; background: none; border-radius: 0; border-style: solid; border-width: 0.375rem 0 0.375rem 0.625rem; border-color: transparent transparent transparent var(--ink); }
  .hv-pause-input:checked + .hv-pause-ui::after { display: none; }
  .hv-pause-input:focus-visible + .hv-pause-ui { outline: 3px solid var(--ink); outline-offset: 3px; }
  .hv-pause:hover .hv-pause-ui { border-color: var(--ink); }

  .hero-facts { margin-top: var(--s-8); display: grid; padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .hero-facts li { display: grid; gap: 0.125rem; justify-items: center; text-align: center; padding-block: var(--s-3); }
  .hero-facts li + li { border-top: 1px solid var(--line); }
  @media (min-width: 48rem) {
    .hero-facts { grid-template-columns: repeat(3, 1fr); }
    .hero-facts li { padding: 0 var(--s-5); }
    .hero-facts li + li { border-top: 0; border-left: 1px solid var(--line); }
  }
  .hero-facts strong { font-size: var(--step-3); font-weight: 850; letter-spacing: -0.03em; line-height: 1.1; }
  .hero-facts span { color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; max-width: 28ch; }
  .hero-src { margin-top: var(--s-4); text-align: center; font-size: var(--step--1); }

  /* The three referees take turns. Each card's words arrive one at a time. Hover to pause and read. */
  @media (prefers-reduced-motion: no-preference) {
    .hv-card, .hv-card:first-child { animation: hv-card 15s var(--ease) infinite both; animation-delay: calc(var(--k) * 5s); }
    @keyframes hv-card {
      0% { opacity: 0; transform: translateY(16px); }
      3%, 30% { opacity: 1; transform: none; }
      33.3%, 100% { opacity: 0; transform: translateY(-12px) scale(0.985); }
    }
    /* On each turn the resume line is there first. The answer follows a moment later. */
    .hv-ans { animation: hv-ans 15s var(--ease) infinite both; animation-delay: calc(var(--k) * 5s); }
    @keyframes hv-ans {
      0%, 6% { opacity: 0; transform: translateY(10px); }
      10%, 100% { opacity: 1; transform: none; }
    }
    .hv-card:first-child .hv-w { display: inline-block; animation: hv-word 0.5s var(--ease) both; animation-delay: calc(1250ms + var(--i) * 60ms); }
    @keyframes hv-word { from { opacity: 0.12; transform: translateY(4px); } }
    .hv-deck:hover .hv-card, .hv-deck:hover .hv-ans { animation-play-state: paused; }
    @supports selector(:has(*)) {
      .hv-pause { display: block; }
      .hv:has(.hv-pause-input:checked) .hv-card, .hv:has(.hv-pause-input:checked) .hv-ans { animation-play-state: paused; }
    }
    /* The entrance, once, as the page opens: the headline rises a line at a time from behind an edge,
       the words under it follow, the first reference lands, and the tally settles on it. */
    .rise-line > span { animation: rise-in 0.9s var(--ease) both; animation-delay: calc(40ms + var(--d) * 110ms); }
    @keyframes rise-in { from { transform: translateY(108%); } }
    .enter { animation: enter-up 0.8s var(--ease) both; animation-delay: var(--at, 0ms); }
    @keyframes enter-up { from { opacity: 0; transform: translateY(16px); } }
    .hv-deck { animation: land 1.05s cubic-bezier(0.2, 0.8, 0.2, 1) 350ms both; }
    @keyframes land { 0% { opacity: 0; transform: translate(-4%, 11%) rotate(-5deg) scale(0.94); } 55% { opacity: 1; } }
    .hv-tally { animation: settle 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 900ms both; }
    @keyframes settle { from { opacity: 0; transform: rotate(2.5deg) translateY(-16px); } }
    .hl::after { animation: hl-draw 0.7s var(--ease) 0.8s both; }
    @keyframes hl-draw { from { transform: scaleX(0); } }
    .hv-ghost { animation: hv-in 0.7s var(--ease) 1.1s both; }
    .hv-g2 { animation-delay: 1.25s; }
    @keyframes hv-in { from { opacity: 0; } }
  }
</style>
