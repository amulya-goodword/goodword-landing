---
// Real screenshots from the app, one for each step of How it works, chosen with "kind".
interface Props { kind: string; class?: string }
const { kind, class: className } = Astro.props;
---
{kind === 'shot-invite' && (
  <figure class:list={['dk-shot', 'dk-shot-narrow', className]}>
    <img src="/img/app-invite.webp" srcset="/img/app-invite-half.webp 360w, /img/app-invite.webp 720w" sizes="(min-width: 62rem) 22rem, 90vw" width="720" height="1020" loading="lazy" decoding="async" alt="The first screen in the app: a greeting, then Who will vouch for you, with three empty places to invite people, the button to invite the first referee and a line to WhatsApp Amulya, who built GoodWord and replies personally." />
  </figure>
)}
{kind === 'shot-referee' && (
  <figure class:list={['dk-shot', className]}>
    <img src="/img/app-referee-answer.webp" srcset="/img/app-referee-answer-half.webp 372w, /img/app-referee-answer.webp 744w" sizes="(min-width: 62rem) 26rem, 90vw" width="744" height="1160" loading="lazy" decoding="async" alt="A referee's answer as it appears in the app: Neha Kapoor, Direct Manager, on where Aarav excels and where he could grow." />
  </figure>
)}
{kind === 'shot-report' && (
  <figure class:list={['dk-shot', className]}>
    <img src="/img/app-report-top.webp" srcset="/img/app-report-top-half.webp 404w, /img/app-report-top.webp 808w" sizes="(min-width: 62rem) 26rem, 90vw" width="808" height="1460" loading="lazy" decoding="async" alt="The opening of a GoodWord report in the app: Aarav Mehta, the checks on each reference and the summary written from the referees' words. A sample." />
  </figure>
)}
