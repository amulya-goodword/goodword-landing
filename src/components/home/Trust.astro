---
// Why a recruiter can trust it, a note from the founder and the closing ask.
import AppLink from '../AppLink.astro';
import Arrow from '../Arrow.astro';
import Tick from '../Tick.astro';
import Piece from '../report/ReportPieces.astro';

const honest = [
  'Words only. No ratings, no scores.',
  'Nobody can edit what a referee wrote.',
  'Not a background check. We say so.',
];
---
<section class="honest on-navy" aria-labelledby="honest-h">
  <div class="wrap honest-in">
    <div>
      <h2 id="honest-h">Why a recruiter can trust it.</h2>
      <ul class="honest-list">
        {honest.map((h) => (
          <li class="reveal"><Tick small /><p>{h}</p></li>
        ))}
      </ul>
    </div>
    <figure class="honest-quote reveal">
      <blockquote>It's easier for us to identify the real potential candidates, quicker.</blockquote>
      <figcaption>A hiring manager in our pilot · <a class="link" href="/for-recruiters/">For recruiters</a></figcaption>
    </figure>
  </div>
</section>

<section class="section note" aria-labelledby="note-h">
  <div class="wrap note-grid">
    <h2 id="note-h">Made by a candidate, for candidates.</h2>
    <div class="note-body reveal">
      <p>When I was job hunting, my applications landed in a pile. Nothing set them apart.</p>
      <p class="note-pull">Now AI has made everyone a superhero on paper.</p>
      <p>So I built the differentiator I wished I had: the word of people who have worked with you. I think it is the best one there is.</p>
      <p class="note-sign"><img class="note-av" src="/img/amulya-nidhi-256.webp" srcset="/img/amulya-nidhi-128.webp 128w, /img/amulya-nidhi-256.webp 256w, /img/amulya-nidhi-512.webp 512w" sizes="56px" width="256" height="256" alt="" loading="lazy" decoding="async" /><span><strong>Amulya Nidhi</strong>, Founder<br /><a class="link" href="/about/">Why I built GoodWord</a></span></p>
    </div>
  </div>
</section>

<section class="closer on-navy" aria-labelledby="closer-h">
  <div class="wrap closer-grid">
    <div class="closer-copy">
      <h2 id="closer-h" class="display">Apply to jobs with a GoodWord.</h2>
      <p class="lede">Send your resume. Send who vouches for it.</p>
      <div class="cluster closer-cta">
        <AppLink to="register" page="home" section="closer" class="btn btn-primary btn-lg">Start my GoodWord <Arrow /></AppLink>
        <AppLink to="sample" page="home" section="closer" class="btn btn-ghost btn-lg">See a sample report</AppLink>
      </div>
      <p class="closer-free">Free to sign up.</p>
    </div>
    <div class="closer-msg reveal"><Piece piece="message" /></div>
  </div>
</section>

<style is:global>
  .honest, .note, .closer { content-visibility: auto; contain-intrinsic-size: auto 520px; }
  .honest { padding-block: clamp(2.5rem, 1.9rem + 2.6vw, 4rem); }
  .honest-in { display: grid; gap: var(--s-6); align-items: center; }
  @media (min-width: 62rem) { .honest-in { grid-template-columns: 1fr 1fr; gap: var(--s-8); } }
  .honest h2 { font-size: var(--step-3); }
  .honest-list { margin-top: var(--s-4); display: grid; }
  .honest-list li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; padding-block: var(--s-3); border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .honest-list .tick { margin-top: 0.1875rem; }
  .honest-list p { font-size: var(--step-0); font-weight: 650; line-height: 1.4; }
  .honest-quote { display: grid; gap: var(--s-3); padding-left: var(--s-5); border-left: 3px solid var(--gold); }
  .honest-quote blockquote { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .honest-quote figcaption { font-size: var(--step--1); color: var(--on-navy-2); }

  .note { border-top: 1px solid var(--line); }
  .note-grid { display: grid; gap: var(--s-5); align-items: start; }
  @media (min-width: 62rem) { .note-grid { grid-template-columns: 0.9fr 1.1fr; gap: var(--s-8); } }
  .note h2 { font-size: var(--step-4); max-width: 13ch; }
  .note-body { display: grid; gap: var(--s-4); max-width: 36rem; }
  .note-body p { font-size: var(--step-1); line-height: 1.55; color: var(--ink-2); }
  .note-body .note-pull { font-size: var(--step-3); font-weight: 850; letter-spacing: -0.03em; line-height: 1.12; color: var(--ink); padding-left: var(--s-4); border-left: 4px solid var(--gold); }
  .note-body .note-sign { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-2); font-size: var(--step-0); line-height: 1.5; color: var(--ink); }
  .note-av { flex: none; width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; background: var(--bar); }

  .closer { padding-block: var(--section); overflow: clip; }
  .closer-grid { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 62rem) { .closer-grid { grid-template-columns: 1.1fr 0.9fr; gap: var(--s-8); } }
  .closer-copy > * + * { margin-top: var(--s-4); }
  .closer-copy .display { max-width: 11ch; }
  .closer-cta { margin-top: var(--s-5); }
  .closer-copy .closer-free { margin-top: var(--s-3); font-size: var(--step--1); color: var(--on-navy-2); }
  @media (max-width: 30rem) { .closer-cta .btn { width: 100%; } }
  .closer-msg { color: var(--ink); justify-self: center; width: 100%; max-width: 30rem; }
  .closer-msg .meta { color: var(--ink-3); }
  .closer-msg .msg { max-width: none; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55); }
</style>
